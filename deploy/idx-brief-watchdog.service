[Unit]
Description=Indonesia Morning News Brief — published-check watchdog
Documentation=https://github.com/andrebenas77/indonesia-morning-news-brief
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=andrebenas77
Group=andrebenas77
WorkingDirectory=/home/andrebenas77/indonesia-morning-news-brief

# Needs only the Telegram credentials to raise the alarm.
EnvironmentFile=/etc/idx-screener.env
Environment=PATH=/home/andrebenas77/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Jakarta

# The only check that catches "the timer never fired at all" — an in-run
# verification cannot detect a run that never started, by construction.
ExecStart=/usr/bin/python3 /home/andrebenas77/indonesia-morning-news-brief/scripts/check_published.py --notify

TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
