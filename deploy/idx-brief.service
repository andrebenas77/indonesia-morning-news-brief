[Unit]
Description=Indonesia Morning News Brief — daily run
Documentation=https://github.com/andrebenas77/indonesia-morning-news-brief
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The account really in use on the VPS is andrebenas77, not a dedicated
# "screener" user. VPS-SETUP.md describes creating one, but the box was built
# with the Biznet default account and root's authorized_keys carries the stock
# forced-command banner redirecting to it. Matching reality here rather than
# the doc: a User= that does not exist fails the unit at start with a bare
# 217/USER and no useful message.
User=andrebenas77
Group=andrebenas77
WorkingDirectory=/home/andrebenas77/indonesia-morning-news-brief

# Two files: the screener's carries the Claude token, Sectors key and Telegram
# credentials; the brief's adds DeepSeek and the shared-cache pointers.
EnvironmentFile=/etc/idx-screener.env
EnvironmentFile=/etc/idx-brief.env

# The native installer puts claude in ~/.local/bin, which is not on systemd's PATH.
Environment=PATH=/home/andrebenas77/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Jakarta
Environment=PYTHONIOENCODING=utf-8
# Standing authorisation for the unattended run: publish without asking.
Environment=BRIEF_UNATTENDED=1

ExecStart=/bin/bash /home/andrebenas77/indonesia-morning-news-brief/scripts/run_brief.sh --trigger timer

TimeoutStartSec=25min

NoNewPrivileges=true
# Must stay false: run_brief.sh and the screener's run_daily.sh serialise on a
# shared /tmp/idx-screener.lock, and PrivateTmp would give each its own /tmp so
# the lock would never be seen. Two Claude Code processes on a 2 GB box thrash.
PrivateTmp=false
ProtectSystem=full
ProtectHome=false
# Deliberately no MemoryMax: on 2 GB + 4 GB swap a cap turns a slow run into an
# OOM kill. Measure first.
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
