[Unit]
Description=Indonesia Morning News Brief — daily run
Documentation=https://github.com/andrebenas77/indonesia-morning-news-brief
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=screener
Group=screener
WorkingDirectory=/home/screener/indonesia-morning-news-brief

# Two files: the screener's (shared — Claude token, Sectors key, Telegram creds) and
# this brief's own. Neither is prefixed with '-', so a missing file fails the unit
# loudly instead of starting a run that cannot possibly work.
EnvironmentFile=/etc/idx-screener.env
EnvironmentFile=/etc/idx-brief.env

# The native installer puts claude in ~/.local/bin, which is not on systemd's PATH.
Environment=PATH=/home/screener/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Jakarta
Environment=PYTHONIOENCODING=utf-8
Environment=BRIEF_UNATTENDED=1

ExecStart=/bin/bash /home/screener/indonesia-morning-news-brief/scripts/run_brief.sh --trigger timer

# Generous: the script may wait up to 20 min on the screener's lock before its own
# work even starts.
TimeoutStartSec=45min

NoNewPrivileges=true
# MUST stay false — run_brief.sh and run_daily.sh coordinate through the shared
# /tmp/idx-screener.lock, and a private /tmp would give each its own, defeating it.
PrivateTmp=false
ProtectSystem=full
ProtectHome=false

# Deliberately NO MemoryMax. On a 2 GB box with 4 GB swap a cap converts a merely
# slow run into an OOM kill. Measure with `free -m` under load first.
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
